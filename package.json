{
  "name": "bashaway-backend",
  "version": "2.1.0",
  "description": "Backend",
  "main": "dist/app.js",
  "scripts": {
    "build": "npm run clean && npm run build-babel && npm run copy",
    "build-babel": "babel -d ./dist ./src -s",
    "clean": "rm -rf dist && mkdir dist",
    "copy": "babel src --out-dir ./dist --copy-files",
    "dev": "nodemon --exec babel-node src/app.js",
    "format": "prettier --write --cache \"**/*.{js,md,html}\"",
    "lint": "eslint src --ext js,md --ignore-path .gitignore --fix --cache --report-unused-disable-directives",
    "prepare": "lefthook install",
    "start": "node dist/app.js",
    "test": "babel-node test/index.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sliit-foss/bashaway-backend.git"
  },
  "author": "SLIIT FOSS",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sliit-foss/bashaway-backend/issues"
  },
  "homepage": "https://github.com/sliit-foss/bashaway-backend#readme",
  "dependencies": {
    "@faker-js/faker": "10.6.0",
    "@sliit-foss/functions": "2.2.4",
    "@sliit-foss/http-logger": "1.1.2",
    "@sliit-foss/module-logger": "1.1.5",
    "@sliit-foss/mongoose-audit": "1.0.4",
    "@sliit-foss/service-connector": "1.2.4",
    "bcryptjs": "2.4.3",
    "celebrate": "15.0.3",
    "compression": "1.8.2",
    "cors": "2.8.6",
    "express": "4.22.3",
    "express-http-context": "1.2.4",
    "express-rate-limit": "6.5.1",
    "handlebars": "4.7.10",
    "helmet": "5.1.0",
    "http-errors": "2.0.1",
    "jsonwebtoken": "9.0.3",
    "lodash": "4.18.1",
    "migrate-mongo": "9.0.0",
    "mongoose": "6.13.13",
    "mongoose-aggregate-paginate-v2": "1.1.5",
    "mongoose-paginate-v2": "1.9.5",
    "nodemailer": "10.6.0"
  },
  "devDependencies": {
    "@babel/cli": "7.29.7",
    "@babel/core": "7.29.13",
    "@babel/eslint-parser": "7.29.13",
    "@babel/node": "7.29.7",
    "@babel/preset-env": "7.29.14",
    "@commitlint/cli": "17.6.5",
    "@commitlint/config-conventional": "17.6.5",
    "@sliit-foss/eslint-config-internal": "1.1.4",
    "@trivago/prettier-plugin-sort-imports": "4.3.0",
    "babel-plugin-module-resolver": "5.0.0",
    "dotenv": "16.0.1",
    "eslint": "8.45.0",
    "eslint-plugin-import": "2.27.5",
    "lefthook": "1.4.3",
    "nodemon": "3.0.1",
    "prettier": "2.8.8"
  },
  "packageManager": "pnpm@10.34.9",
  "pnpm": {
    "overrides": {
      "axios": "1.21.1",
      "lodash": "4.18.1"
    }
  }
}
